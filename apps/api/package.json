{
  "name": "@acorn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @acorn/contracts build",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretest": "pnpm --filter @acorn/contracts build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/infrastructure/persistence/seed.ts",
    "db:reset": "tsx src/infrastructure/persistence/reset-db.ts",
    "demo:prepare-listening": "tsx scripts/prepare-demo-listening-audio.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acorn/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.654.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@acorn/config": "workspace:*",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.8",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
