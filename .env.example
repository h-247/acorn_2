# App
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# PostgreSQL
POSTGRES_DB=acorn
POSTGRES_USER=acorn
POSTGRES_PASSWORD=acorn_dev_only
DATABASE_URL=postgresql://acorn:acorn_dev_only@localhost:5432/acorn

# S3-compatible object storage (local MinIO by default)
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=acorn-dev
OBJECT_STORAGE_ACCESS_KEY=acorn
OBJECT_STORAGE_SECRET_KEY=acorn_dev_only
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# AI adapter
AI_PROVIDER=mock
AI_MODEL=mock
AI_API_KEY=

# Product configuration
RECENT_EVIDENCE_COUNT=20
