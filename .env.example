# App
WEB_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
JWT_SECRET=acorn_super_secret_jwt_key_for_dev_123

# PostgreSQL (Port 5435 isolated to avoid collisions with Windows/other services)
POSTGRES_DB=acorn
POSTGRES_USER=acorn
POSTGRES_PASSWORD=acorn_dev_only
POSTGRES_PORT=5435
DATABASE_URL=postgresql://acorn:acorn_dev_only@localhost:5435/acorn

# S3-compatible object storage (SeaweedFS S3 local default per ADR-0003)
OBJECT_STORAGE_PROVIDER=seaweedfs
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=acorn-dev
OBJECT_STORAGE_ACCESS_KEY=acorn
OBJECT_STORAGE_SECRET_KEY=acorn_dev_only
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Product configuration
RECENT_EVIDENCE_COUNT=20
